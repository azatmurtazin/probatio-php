{
    "name": "azatmurtazin/probatio-php",
    "description": "Probatio-php is a simple testing framework",
    "keywords": [
        "php",
        "unit",
        "test",
        "testing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Azat Murtazin",
            "email": "murtazin.azat@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Probatio\\": "src/Probatio/",
            "Probatio\\Examples\\": "examples/src/"
        },
        "files": [
            "src/Probatio/GlobalFunctions.php",
            "src/Probatio/Functions.php"
        ]
    },
    "bin": [
        "bin/probatio"
    ],
    "scripts": {
        "test": "./bin/probatio tests"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=7.2"
    }
}
